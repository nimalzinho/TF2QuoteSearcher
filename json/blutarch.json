            },
            {
                "type": "wav",
                "file": "Sf13_blutarch_bridge01",
                "text": "Cross the bridge!",
                "wiki": "b/bc"
            },
            {
                "type": "wav",
                "file": "Sf13_blutarch_bridge02",
                "text": "The bridge is down!",
                "wiki": "e/e7"
            },
            {
                "type": "wav",
                "file": "Sf13_blutarch_bridge03",
                "text": "The bridge, you fools!",
                "wiki": "7/75"
            },
            {
                "type": "wav",
                "file": "Sf13_blutarch_bridge04",
                "text": "The bridge, you lackeys!",
                "wiki": "6/6d"
            },
            {
                "type": "wav",
                "file": "Sf13_blutarch_bridge05",
                "text": "Hell Island is open! The bridge is down!",
                "wiki": "1/16"
            },
            {
                "type": "wav",
                "file": "Sf13_blutarch_bridge06",
                "text": "Hurry! Cross the bridge to Hell Island! Get the good magic!",
                "wiki": "e/ef"
            },
            {
                "type": "wav",
                "file": "Sf13_blutarch_bridge07",
                "text": "Hurry! Cross the bridge! Gather up the best spells!",
                "wiki": "8/88"
            },
            {
                "type": "wav",
                "file": "Sf13_blutarch_bridge08",
                "text": "The bridge! Across it lies power beyond imagination!",
                "wiki": "3/33"
            },
            {
                "type": "wav",
                "file": "Sf13_blutarch_bridge09",
                "text": "Don't settle for this paltry stuff! Cross the bridge!",
                "wiki": "9/96"
            },
            {
                "type": "wav",
                "file": "Sf13_blutarch_enemies01",
                "text": "The hell is happening now?",
                "wiki": "2/27"
            },
            {
                "type": "wav",
                "file": "Sf13_blutarch_enemies02",
                "text": "What's happening down there?",
                "wiki": "d/d9"
            },
            {
                "type": "wav",
                "file": "Sf13_blutarch_enemies03",
                "text": "What the gravel is happening down there?",
                "wiki": "4/4d"
            },
            {
                "type": "wav",
                "file": "Sf13_blutarch_enemies04",
                "text": "Aw, no! Zombies!",
                "wiki": "2/28"
            },
            {
                "type": "wav",
                "file": "Sf13_blutarch_enemies05",
                "text": "Zombies!",
                "wiki": "e/ed"
            },
            {
                "type": "wav",
                "file": "Sf13_blutarch_enemies06",
                "text": "Hell zombies!",
                "wiki": "1/17"
            },
            {
                "type": "wav",
                "file": "Sf13_blutarch_enemies07",
                "text": "Oh no, werewolves! No, wait... skeletons! Zombies? It doesn't matter, just run!",
                "wiki": "d/d2"
            },
            {
                "type": "wav",
                "file": "Sf13_blutarch_enemies08",
                "text": "Hell zombies! Oh gravelpits, you are in for it now!",
                "wiki": "a/ae"
            },
            {
                "type": "wav",
                "file": "Sf13_blutarch_enemies09",
                "text": "Zombies, no! Wait... Hold on, let me check it... Oh god! Hell zombies!",
                "wiki": "7/77"
            },
            {
                "type": "wav",
                "file": "Sf13_blutarch_enemies10",
                "text": "Oh no, it's the Skeleton King!",
                "wiki": "9/96"
            },
            {
                "type": "wav",
                "file": "Sf13_blutarch_enemies11",
                "text": "Oh good, the Skeleton King's here.",
                "wiki": "c/cf"
            },
            {
                "type": "wav",
                "file": "Sf13_blutarch_enemies12",
                "text": "It's the Skeleton King!",
                "wiki": "0/0f"
            },
            {
                "type": "wav",
                "file": "Sf13_blutarch_enemies13",
                "text": "Run! It's the Skeleton King!",
                "wiki": "4/44"
            },
            {
                "type": "wav",
                "file": "Sf13_blutarch_enemies14",
                "text": "It's the Horseless Headless Horsemann!",
                "wiki": "0/02"
            },
            {
                "type": "wav",
                "file": "Sf13_blutarch_enemies15",
                "text": "The Skeleton King! Ah gravelpits, you are in for it now!",
                "wiki": "8/8d"
            },
            {
                "type": "wav",
                "file": "Sf13_mannbros_argue01",
                "text": "Don't listen to my idiot brother, get them!",
                "wiki": "a/a1"
            },
            {
                "type": "wav",
                "file": "Sf13_mannbros_argue02",
                "text": "Spells! Don't pick them up, they're all poison!",
                "wiki": "1/14"
            },
            {
                "type": "wav",
                "file": "Sf13_mannbros_argue03",
                "text": "Don't listen to him, send MY imbecile brother to hell! *short laugh*",
                "wiki": "1/16"
            },
            {
                "type": "wav",
                "file": "Sf13_mannbros_argue04",
                "text": "Yes, I'll enjoy staring down at it, from heaven! While you BURN, brother! *short laugh*",
                "wiki": "4/45"
            },
            {
                "type": "wav",
                "file": "Sf13_mannbros_argue05",
                "text": "There is no gravel where you're going, brother! Hell, Redmond! What do you think is going on here?",
                "wiki": "d/da"
            },
            {
                "type": "wav",
                "file": "Sf13_mannbros_argue06",
                "text": "Send my brother to hell! DO do it! Continue doing it!",
                "wiki": "9/9f"
            },
            {
                "type": "wav",
                "file": "Sf13_mannbros_argue07",
                "text": "Don't do it! No! Nooooooo!",
                "wiki": "1/1b"
            },
            {
                "type": "wav",
                "file": "Sf13_mannbros_argue08",
                "text": "Shut up, Redmond! Keep fighting! Don't listen to my idiot brother!",
                "wiki": "b/be"
            },
            {
                "type": "wav",
                "file": "Sf13_mannbros_argue09",
                "text": "RED team! Stop fighting! My brother and I call truce! *laughing*",
                "wiki": "2/26"
            },
            {
                "type": "wav",
                "file": "Sf13_mannbros_argue10",
                "text": "That's you, you imbecile!",
                "wiki": "d/d8"
            },
            {
                "type": "wav",
                "file": "Sf13_mannbros_argue11",
                "text": "You, Redmond! Ha ha ha! I've turned it around on you!",
                "wiki": "2/22"
            },
            {
                "type": "wav",
                "file": "Sf13_mannbros_argue12",
                "text": "Only one of us is going to hell, Redmond! I'm afraid I'll be the one not seeing you! I won't!",
                "wiki": "0/03"
            },
            {
                "type": "wav",
                "file": "Sf13_mannbros_argue13",
                "text": "Don't listen to him! It's just beginning! It is the Witching Hour!",
                "wiki": "2/29"
            },
            {
                "type": "wav",
                "file": "Sf13_mannbros_argue14",
                "text": "The Witching Hour is over! *laughing*",
                "wiki": "b/b7"
            },
            {
                "type": "wav",
                "file": "Sf13_mannbros_argue15",
                "text": "Don't listen to him, father! It's still anyone's game right now!",
                "wiki": "8/8b"
            },
            {
                "type": "wav",
                "file": "Sf13_mannbros_argue16",
                "text": "I'm doing it, father! I'm winning!",
                "wiki": "6/64"
            },
            {
                "type": "wav",
                "file": "Sf13_mannbros_argue17",
                "text": "I do, brother! It is the heat of victory!",
                "wiki": "f/fa"
            },
            {
                "type": "wav",
                "file": "Sf13_mannbros_argue18",
                "text": "Yes! Pushing! I'm a tactical genius! The only thing you invented years ago was losing to me right now! *laughing*",
                "wiki": "d/dc"
            },
            {
                "type": "wav",
                "file": "Sf13_mannbros_argue19",
                "text": "Dear Lord! This is Blutarch Mann speaking! Shut up, Redmond, I'm praying! Lord, please send my brother to hell. Amen. No!",
                "wiki": "3/31"
            },
            {
                "type": "wav",
                "file": "Sf13_mannbros_argue20",
                "text": "I'm sorry. No! I meant I'm sorry that I'm sending you to hell! And I'm not! Sorry!",
                "wiki": "e/ef"
            },
            {
                "type": "wav",
                "file": "Sf13_mannbros_argue21",
                "text": "Knock knock. Redmond, it's Blutarch! This is a knock knock joke! Open this door at once! Redmond, I assure you I will make it worth your while. Now knock knock It's your brother Blutarch! Now for God's sake let me in! Someone's trying to send me to Hell! Good Lord! That changes everything! I'll finish the joke later!",
                "wiki": "e/ed"
            },
            {
                "type": "wav",
                "file": "Sf13_mannbros_argue22",
                "text": "*giggling* Oh, I'm just thinking about all the gravel I'll have when you're gone. The devil! I plan to trade him all your gravel for it!",
                "wiki": "c/ce"
            },
            {
                "type": "wav",
                "file": "Sf13_mannbros_argue23",
                "text": "Yes! Yes! Send my brother to hell! I'm not talking to you, Redmond. I'm talking to the mercs! Come on brother. What could they possibly be doing? What? RED team! Stop what you're doing!",
                "wiki": "2/23"
            },
            {
                "type": "wav",
                "file": "Sf13_mannbros_argue24",
                "text": "Wait, what was that? My mercs? Don't you dare! They've got a job! Sending you to hell, Redmond! Belay that order, BLU team!",
                "wiki": "6/69"
            },
            {
                "type": "wav",
                "file": "Sf13_mannbros_argue25",
                "text": "You imbecile! *shuffling noise* This is what I'm paying them!",
                "wiki": "c/c3"
            },
            {
                "type": "wav",
                "file": "Sf13_mannbros_argue26",
                "text": "You there! RED team! I'll double what my ratstink brother is paying you! Ah! Never mind!",
                "wiki": "1/16"
            },
            {
                "type": "wav",
                "file": "Sf13_mannbros_argue27",
                "text": "Look at me now, father!",
                "wiki": "c/c4"
            },
            {
                "type": "wav",
                "file": "Sf13_mannbros_argue28",
                "text": "Look at me now, father! Yes, yes, yes, yes! No! Noooo!",
                "wiki": "9/98"
            },
            {
                "type": "wav",
                "file": "Sf13_blutarch_misc01",
                "text": "This update almost makes too much sense! *laughing*",
                "wiki": "8/80"
            },
            {
                "type": "wav",
                "file": "Sf13_blutarch_misc02",
                "text": "It all makes perfect sense!",
                "wiki": "9/95"
            },
            {
                "type": "wav",
                "file": "Sf13_blutarch_misc03",
                "text": "What the gravel am I paying you for? I'll tell you: I'm not! Unless you get my brother to hell!",
                "wiki": "9/97"
            },
            {
                "type": "wav",
                "file": "Sf13_blutarch_misc04",
                "text": "All you have to do is send my brother's haunted corpse to hell, then run across a bridge to an enchanted island every time the clock strikes midnight every one and a half minutes to get powerful spells you can use to defeat your enemy, who will be doing the exact same thing, but with my haunted corpse! My only worry is this update makes too much sense.",
                "wiki": "d/d3"
            },
            {
                "type": "wav",
                "file": "Sf13_blutarch_misc05",
                "text": "I am speaking to you from the great beyond! But make no mistake, my lawyers are still on Earth, and they will prosecute if you do not fulfill your contract. In fact, they're right over there in that evil castle! That's right! They built a terrifying mansion from which to conduct their day business! *chuckle*",
                "wiki": "d/da"
            },
            {
                "type": "wav",
                "file": "Sf13_blutarch_misc06",
                "text": "I sense a disturbance in the force... Hold on. Okay, I'm back. My lawyers tell me I'm sensing nothing.",
                "wiki": "1/14"
            }
        ],
