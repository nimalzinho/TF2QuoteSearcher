{
    "character": {
        "name": "redmond",
        "citations": {
            "responses": "\"Halloween Boss voice responses.\" Team Fortress Wiki, . 23 Nov 2025, 21:59 UTC. 7 Oct 2026, 03:11 |https://wiki.teamfortress.com/w/index.php?title=Halloween_Boss_voice_responses&oldid=4084043",
            "commands": "",
            "taunts": ""
        },
        "responses": [
            {
                "type": "wav",
                "file": "Sf13_redmond_intro_long01",
                "text": "This is Redmond Mann speaking from an unspecified location beyond the grave. I may be dead, but as long as you're cashing my checks, you'll damn well do what you're told. And I'm telling you to push my brother to hell!",
                "wiki": "d/db"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_intro_long02",
                "text": "It is I, your employer, Redmond Mann, from beyond the grave. I've given you thick-skulled slugs one thing to do for a hundred years now: Shoot each other. Now I'm giving you something even easier to do: Push that cart!",
                "wiki": "0/0d"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_intro_short01",
                "text": "This is Redmond Mann, and I've got one simple request: Send my brother to hell!",
                "wiki": "9/9e"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_intro_short02",
                "text": "This is your employer, and I've got a job for you: Send my brother to hell!",
                "wiki": "4/40"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_intro_short03",
                "text": "Listen up you reprobates. This is Redmond Mann. That corpse belongs to my idiot brother. Send it to hell!",
                "wiki": "1/11"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_intro_short04",
                "text": "Listen up you thugs. This is Redmond Mann speaking. And I've got a job for you: Send my brother to hell!",
                "wiki": "2/20"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_winning01",
                "text": "Yes! Yes! Yes yes yes!",
                "wiki": "e/e0"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_winning02",
                "text": "Yes, that's it! Push!",
                "wiki": "4/4f"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_winning03",
                "text": "We're winning! Push!",
                "wiki": "2/23"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_winning04",
                "text": "Good, good!",
                "wiki": "9/91"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_winning05",
                "text": "Yes!",
                "wiki": "7/7f"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_winning06",
                "text": "Perfect!",
                "wiki": "d/d4"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_winning07",
                "text": "Sweet mother of gravel, we're winning!",
                "wiki": "7/79"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_winning08",
                "text": "Whatever it is you're doing, keep doing it!",
                "wiki": "7/72"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_winning09",
                "text": "Whatever it is you're doing, it's working!",
                "wiki": "7/7a"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_winning10",
                "text": "We're winning! Do you hear me, Blutarch! I'm winning!",
                "wiki": "4/4e"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_winning11",
                "text": "I'm doing it! I'm finally actually really doing it! I am the best Mann!",
                "wiki": "3/32"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_winning12",
                "text": "I'm winning! And you're losing, Blutarch! I will be the last man standing!",
                "wiki": "a/a0"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_winning13",
                "text": "How do you like those ghostly apples, Blutarch? No need to answer. They are bitter, tart ash in your mouth, I'm sure of it! Yes, yes, yes yes yes...",
                "wiki": "9/95"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_winning14",
                "text": "We're winning! Do you hear me, Blutarch? The Badlands are mine!",
                "wiki": "6/6c"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_winning15",
                "text": "We're winning! Do you hear me, Blutarch? I'm the best son!",
                "wiki": "6/6c"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_winning16",
                "text": "I'm doing it! I'm sending you to hell, Blutarch!",
                "wiki": "a/a9"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_winning17",
                "text": "Yes! I should've died years ago!",
                "wiki": "0/0a"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_winning18",
                "text": "Yes! All of my beautiful ghost plans are being realized!",
                "wiki": "f/f8"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_winning19",
                "text": "We're winning! Getting stabbed nine times in the heart was the greatest thing to ever happen to me!",
                "wiki": "a/a8"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_winning20",
                "text": "Yes! Sending my brother to hell was my best idea since the pregnancy machine! ...Which isn't off the table, by the way.",
                "wiki": "d/df"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_losing_push01",
                "text": "Push!",
                "wiki": "d/d7"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_losing_push02",
                "text": "Puuuush!",
                "wiki": "c/c0"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_losing_push03",
                "text": "Keep pushing!",
                "wiki": "8/81"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_losing_push04",
                "text": "Keep pushing the cart!",
                "wiki": "9/99"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_losing_push05",
                "text": "Get to the cart!",
                "wiki": "9/93"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_losing_push06",
                "text": "Don't leave the cart!",
                "wiki": "b/bc"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_losing_push07",
                "text": "Puuuush!",
                "wiki": "b/b0"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_losing_push08",
                "text": "Puuuuuuush!",
                "wiki": "2/29"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_losing01",
                "text": "No, you stupid poor people!",
                "wiki": "b/b8"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_losing02",
                "text": "Blast! I should've hired the BLU team!",
                "wiki": "c/c2"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_losing03",
                "text": "We're losing!",
                "wiki": "3/37"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_losing04",
                "text": "We're behind! Fight harder, you imbeciles!",
                "wiki": "5/59"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_losing05",
                "text": "They're winning!",
                "wiki": "d/d1"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_losing06",
                "text": "Fight, you nincompoops! They're beating us!",
                "wiki": "3/37"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_losing07",
                "text": "Biscuits and buncum, we're losing!",
                "wiki": "9/9b"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_losing08",
                "text": "Patswater! They're winning!",
                "wiki": "b/be"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_losing09",
                "text": "Posspoddle, we're losing!",
                "wiki": "6/6a"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_losing10",
                "text": "Pissdumplings! They're beating us!",
                "wiki": "b/b4"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_losing11",
                "text": "Hogwater, we're losing!",
                "wiki": "d/d8"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_losing12",
                "text": "Boggarbottom! We're losing!",
                "wiki": "5/5f"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_losing13",
                "text": "Why is my brother not in hell yet?",
                "wiki": "b/ba"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_losing14",
                "text": "What am I paying you for? Push my brother to hell!",
                "wiki": "a/ac"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_losing15",
                "text": "Wait a minute... Am I closer to hell than my brother?",
                "wiki": "0/09"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_losing16",
                "text": "Why is my brother winning?",
                "wiki": "2/29"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_losing17",
                "text": "You charlatans promised me you'd send my brother to hell!",
                "wiki": "e/ef"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_losing18",
                "text": "Damn it all, get that ratstink carcass to hell! Or by gravel, I will end you!",
                "wiki": "9/95"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_losing19",
                "text": "What the gravel am I paying you for?",
                "wiki": "6/66"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_losing20",
                "text": "You unwashed reprobates! It's not gravel science!",
                "wiki": "0/0b"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_losing21",
                "text": "Damn you Blutarch!",
                "wiki": "8/8e"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_almost_lost01",
                "text": "Good gravel! I'm almost to hell, you idiots! Do something!",
                "wiki": "3/3d"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_almost_won01",
                "text": "Good gravel! You've almost done it!",
                "wiki": "4/4a"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_win01",
                "text": "I've done it!",
                "wiki": "8/84"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_win02",
                "text": "Yes! Yes yes yes yes! I did it!",
                "wiki": "e/e5"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_win03",
                "text": "Rot in hell, Blutarch! I win!",
                "wiki": "7/7b"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_win04",
                "text": "Look at me now, father! I won!",
                "wiki": "e/e4"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_win05",
                "text": "Mine! All of the Badlands is finally mine!",
                "wiki": "d/da"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_win06",
                "text": "After a hundred years, I am the last man standing!",
                "wiki": "0/0b"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_win07",
                "text": "I won! Wait, where are you all going?",
                "wiki": "a/aa"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_win08",
                "text": "I won! Now you all can go to hell!",
                "wiki": "d/d3"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_win09",
                "text": "I won! And just so I don't have to pay you, go to hell! *laughs*",
                "wiki": "7/77"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_lose01",
                "text": "No! Noooooooo!",
                "wiki": "6/62"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_lose02",
                "text": "No! Noooooooooooo!",
                "wiki": "6/6e"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_lose03",
                "text": "I'm taking you to hell with me!",
                "wiki": "9/96"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_lose04",
                "text": "Damn you Blutarch!",
                "wiki": "a/a3"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_lose05",
                "text": "Happy Hallowee- *fades off*",
                "wiki": "d/df"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_lose06",
                "text": "Damn you Blutarch!",
                "wiki": "c/c1"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_lose07",
                "text": "Nooooooo- *fades off*",
                "wiki": "e/e7"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_lose08",
                "text": "No! Noooooo!",
                "wiki": "1/18"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_win02_music",
                "text": "Yes! Yes yes yes yes! I did it! *victory theme*",
                "wiki": "2/2e"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_lose08_music",
                "text": "No! Nooooo! *boos*",
                "wiki": "0/08"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_losing19_music",
                "text": "What the gravel am I paying you for? *stalemate theme*",
                "wiki": "c/c5"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_spells_long01",
                "text": "Good! The spells have appeared, just as I planned! Yes... yes! This update almost makes too much sense! *laughs*",
                "wiki": "a/a8"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_spells01",
                "text": "Gather spells while you can!",
                "wiki": "a/a6"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_spells02",
                "text": "Spells! Spells everywhere!",
                "wiki": "2/2a"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_spells03",
                "text": "Gather spells before they disappear!",
                "wiki": "3/3b"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_spells04",
                "text": "Grab the spells and cast them!",
                "wiki": "2/2a"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_spells05",
                "text": "Grab the spells! Cast them on Blutarch's idiot army!",
                "wiki": "4/4a"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_spells06",
                "text": "Spells!",
                "wiki": "a/a0"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_midnight01",
                "text": "The Witching Hour!",
                "wiki": "7/7c"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_midnight02",
                "text": "It's midnight! Gather spells while you can!",
                "wiki": "e/eb"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_midnight03",
                "text": "Yes, it's the Witching Hour!",
                "wiki": "1/1b"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_midnight04",
                "text": "Yes, the Witching Hour is upon us!",
                "wiki": "2/2a"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_midnight05",
                "text": "The Witching Hour! When the wall between worlds grows thin!",
                "wiki": "d/db"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_midnight_again01",
                "text": "It's midnight! Again!",
                "wiki": "9/95"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_midnight_again02",
                "text": "The Witching Hour! Again!",
                "wiki": "e/e0"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_midnight_again03",
                "text": "It's midnight again! Gather spells while you can!",
                "wiki": "9/97"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_midnight_again04",
                "text": "It's midnight again?",
                "wiki": "4/43"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_midnight_again05",
                "text": "It's midnight! ...Again!",
                "wiki": "7/7c"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_midnight_again06",
                "text": "It's midnight... *inhales* Again!",
                "wiki": "d/d7"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_bridge01",
                "text": "The bridge is down!",
                "wiki": "c/ca"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_bridge02",
                "text": "The bridge, you fools! Get the good magic...",
                "wiki": "f/f1"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_bridge03",
                "text": "Hell Island is open! The bridge is down!",
                "wiki": "f/f8"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_bridge04",
                "text": "Hurry! Cross the bridge to Hell Island! That's where the good spells are!",
                "wiki": "5/58"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_bridge05",
                "text": "The bridge, you lackeys! I sense great magic...",
                "wiki": "8/88"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_bridge06",
                "text": "The bridge! Across it lies power beyond imagination!",
                "wiki": "4/47"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_bridge07",
                "text": "Don't settle for this paltry stuff! Cross the bridge!",
                "wiki": "3/3d"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_bridge08",
                "text": "Hurry! Cross the bridge! Gather up the best spells!",
                "wiki": "d/d8"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_enemies01",
                "text": "Zombies!",
                "wiki": "4/49"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_enemies02",
                "text": "Hell zombies!",
                "wiki": "8/8c"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_enemies03",
                "text": "Oh no, werewolves! No, wait... skeletons! Zombies? It doesn't matter, just run!",
                "wiki": "b/b2"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_enemies04",
                "text": "Zombies, no! Wait... *muttering* Hold on, let me check... Oh god! Hell zombies!",
                "wiki": "4/49"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_enemies05",
                "text": "The Skeleton King! Oh... gravelpits, you are in for it now!",
                "wiki": "f/fd"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_enemies06",
                "text": "Oh good, the Skeleton King's he- NO! That's bad!",
                "wiki": "3/34"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_enemies07",
                "text": "It's the Skeleton King!",
                "wiki": "2/28"
            },
            {
                "type": "wav",
                "file": "Sf13_redmond_enemies08",
                "text": "We've awoken the Skeleton King!",
                "wiki": "2/2b"
            },
            {
                "type": "wav",
                "file": "Sf13_mannbros_argue01",
                "text": "Spells! Don't pick them up, they're all poison!",
                "wiki": "a/a1"
            },
            {
                "type": "wav",
                "file": "Sf13_mannbros_argue02",
                "text": "Don't listen to my idiot brother, get them!",
                "wiki": "1/14"
            },
            {
                "type": "wav",
                "file": "Sf13_mannbros_argue03",
                "text": "Send my ratstink brother to hell! What? No! No!",
                "wiki": "1/16"
            },
            {
                "type": "wav",
                "file": "Sf13_mannbros_argue04",
                "text": "I hope you'll enjoy hell, Blutarch! Noooo!",
                "wiki": "4/45"
            },
            {
                "type": "wav",
                "file": "Sf13_mannbros_argue05",
                "text": "That gravel... It will be mine, Blutarch! Oh? And where is that, exactly? What?",
                "wiki": "d/da"
            },
            {
                "type": "wav",
                "file": "Sf13_mannbros_argue06",
                "text": "What? No! Don't do it! No! Nooooooo!",
                "wiki": "9/9f"
            },
            {
                "type": "wav",
                "file": "Sf13_mannbros_argue07",
                "text": "Send my brother to hell! Do do it! Continue doing it!",
                "wiki": "1/1b"
            },
            {
                "type": "wav",
                "file": "Sf13_mannbros_argue08",
                "text": "BLU team! Stop fighting! My brother and I call truce! *laughing*",
                "wiki": "b/be"
            },
            {
                "type": "wav",
                "file": "Sf13_mannbros_argue09",
                "text": "Shut up, Blutarch! Keep fighting! Don't listen to my idiot brother!",
                "wiki": "2/26"
            },
            {
                "type": "wav",
                "file": "Sf13_mannbros_argue10",
                "text": "Look at your corpse, brother. As ugly in death as you were in life, so shriveled and red... What? No!",
                "wiki": "d/d8"
            },
            {
                "type": "wav",
                "file": "Sf13_mannbros_argue11",
                "text": "Send him to hell! Who's the idiot brother now, brother? Nooooo!",
                "wiki": "2/22"
            },
            {
                "type": "wav",
                "file": "Sf13_mannbros_argue12",
                "text": "I'll see you in hell, brother! Then I suppose I won't see you in hell, brother! We shall see.",
                "wiki": "0/03"
            },
            {
                "type": "wav",
                "file": "Sf13_mannbros_argue13",
                "text": "The Witching Hour is over! *laughing*",
                "wiki": "2/29"
            },
            {
                "type": "wav",
                "file": "Sf13_mannbros_argue14",
                "text": "Don't listen to him! It's just beginning! It is the Witching Hour!",
                "wiki": "b/b7"
            },
            {
                "type": "wav",
                "file": "Sf13_mannbros_argue15",
                "text": "I'm doing it, father! I'm winning!",
                "wiki": "8/8b"
            },
            {
                "type": "wav",
                "file": "Sf13_mannbros_argue16",
                "text": "Don't listen to him, father! It's still anyone's game right now!",
                "wiki": "6/64"
            },
            {
                "type": "wav",
                "file": "Sf13_mannbros_argue17",
                "text": "Do you feel the flames of hell yet, brother? What? No! I feel it too! I only feel it!",
                "wiki": "f/fa"
            },
            {
                "type": "wav",
                "file": "Sf13_mannbros_argue18",
                "text": "What? I invented pushing years ago! Noooooo!",
                "wiki": "d/dc"
            },
            {
                "type": "wav",
                "file": "Sf13_mannbros_argue19",
                "text": "And Redmond. Lord, wait! Whatever he's praying to you for, I'll double it. Ha ha ha ha! I win at praying, brother.",
                "wiki": "3/31"
            },
            {
                "type": "wav",
                "file": "Sf13_mannbros_argue20",
                "text": "Blutarch, we're family. Tell you what, on the count of three, let's both apologize and go to heaven. One, two, three. I'm- *laughing* No!",
                "wiki": "e/ef"
            },
            {
                "type": "wav",
                "file": "Sf13_mannbros_argue21",
                "text": "Who is it? No thank you. Who is it? I'm trying to send you to Hell. *laughs*",
                "wiki": "e/ed"
            },
            {
                "type": "wav",
                "file": "Sf13_mannbros_argue22",
                "text": "What's so funny, brother? And where do you intend to get all this gravel in hell, brother? While I'm on Earth, which is virtually made of gravel? *gasps* Don't you dare, Blutarch!",
                "wiki": "c/ce"
            },
            {
                "type": "wav",
                "file": "Sf13_mannbros_argue23",
                "text": "Wait, what was that? My mercs? Don't you dare! They've got a job! Sending you to hell, Blutarch! Belay that order, RED team!",
                "wiki": "2/23"
            },
            {
                "type": "wav",
                "file": "Sf13_mannbros_argue24",
                "text": "Yes! Yes! Send my brother to hell! I'm not talking to you, Blutarch. I'm talking to the mercs! Come on brother. What could they possibly be doing? What? BLU team! Stop what you're doing!",
                "wiki": "6/69"
            },
            {
                "type": "wav",
                "file": "Sf13_mannbros_argue25",
                "text": "You there! BLU team! I'll double what my ratstink brother is paying you! Geh! Never mind!",
                "wiki": "c/c3"
            },
            {
                "type": "wav",
                "file": "Sf13_mannbros_argue26",
                "text": "Blutarch! This is what I'm paying them!",
                "wiki": "1/16"
            },
            {
                "type": "wav",
                "file": "Sf13_mannbros_argue27",
                "text": "Look at me now, father! Yes, yes! Yes yes yes! What? No!",
                "wiki": "c/c4"
            },
            {
                "type": "wav",
                "file": "Sf13_mannbros_argue28",
                "text": "Look at me now, father!",
                "wiki": "9/98"
            }
        ],
